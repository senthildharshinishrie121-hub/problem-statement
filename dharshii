/* ================= PLANNER ================= */

function updatePlanner() {

    const subjectIndex =
        Number(
            document.getElementById(
                "plannerSubject"
            ).value
        );


    const numberOfClasses =
        Number(
            document.getElementById(
                "plannerClasses"
            ).value
        );


    const subject =
        subjects[subjectIndex];


    if (!subject) {
        return;
    }


    const current =
        getPercentage(
            subject.attended,
            subject.conducted
        );


    const future =
        getPercentage(
            subject.attended,
            subject.conducted +
            numberOfClasses
        );


    const canMiss =
        future >= REQUIRED_ATTENDANCE;


    const result =
        document.getElementById(
            "plannerResult"
        );


    result.innerHTML = `

        <h2>
            ${subject.name}
        </h2>

        <p>
            Current attendance:
            <strong>
                ${current.toFixed(1)}%
            </strong>
        </p>

        <div class="result-number">
            ${future.toFixed(1)}%
        </div>

        <div class="result-message">

            If you miss
            <strong>
                ${numberOfClasses}
            </strong>
            upcoming class
            ${numberOfClasses > 1 ? "es" : ""},

            your attendance becomes

            <strong>
                ${future.toFixed(1)}%
            </strong>.

        </div>

        <br>

        <span class="status
            ${canMiss ? "safe" : "danger"}">

            ${canMiss
                ? "✓ SAFE"
                : "⚠ NOT SAFE"}

        </span>

        <p style="margin-top:15px;color:#70798a">

            Required attendance:
            ${REQUIRED_ATTENDANCE}%

        </p>

    `;


    loadRecovery(subject.name);

}


/* ================= RECOVERY ================= */

function loadRecovery(subjectName) {

    const subject =
        subjects.find(
            item => item.name === subjectName
        );


    if (!subject) {
        return;
    }


    const current =
        getPercentage(
            subject.attended,
            subject.conducted
        );


    const required =
        calculateRecovery(
            subject.attended,
            subject.conducted
        );


    const container =
        document.getElementById(
            "recoveryResult"
        );


    if (current >= REQUIRED_ATTENDANCE) {

        container.innerHTML = `

            <div class="recovery-box">

                <strong>
                    ${subject.name}
                </strong>

                <p style="margin-top:8px">
                    Current attendance is
                    ${current.toFixed(1)}%.
                    You are already above the
                    required attendance.
                </p>

            </div>

        `;

        return;
    }


    container.innerHTML = `

        <div class="recovery-box">

            <strong>
                ${subject.name}
            </strong>

            <p style="margin-top:8px">

                Current attendance:
                ${current.toFixed(1)}%

            </p>

            <p style="margin-top:8px">

                You need to attend the next

                <strong>
                    ${required}
                </strong>

                consecutive classes

                to reach at least
                ${REQUIRED_ATTENDANCE}%.

            </p>

        </div>

    `;

}


