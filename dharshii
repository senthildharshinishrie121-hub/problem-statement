/* ================= CALCULATIONS ================= */

function getPercentage(attended, conducted) {

    if (conducted === 0) {
        return 0;
    }

    return (attended / conducted) * 100;
}


/* ================= OVERALL ATTENDANCE ================= */

function getOverallAttendance() {

    let attended = 0;
    let conducted = 0;

    subjects.forEach(subject => {

        attended += subject.attended;
        conducted += subject.conducted;

    });

    return {
        attended,
        conducted,
        percentage:
            getPercentage(attended, conducted)
    };
}


/* ================= SAFE ABSENCES ================= */

function calculateSafeAbsences(attended, conducted) {

    let absences = 0;

    while (
        getPercentage(
            attended,
            conducted + absences + 1
        ) >= REQUIRED_ATTENDANCE
    ) {

        absences++;

        if (absences > 100) {
            break;
        }
    }

    return absences;
}


/* ================= RECOVERY ================= */

function calculateRecovery(attended, conducted) {

    if (
        getPercentage(attended, conducted)
        >= REQUIRED_ATTENDANCE
    ) {
        return 0;
    }

    let classes = 0;

    while (
        getPercentage(
            attended + classes,
            conducted + classes
        ) < REQUIRED_ATTENDANCE
    ) {

        classes++;

        if (classes > 1000) {
            break;
        }
    }

    return classes;
}


/* ================= RISK ================= */

function getRisk(percentage) {

    if (percentage < 75) {

        return {
            text: "CRITICAL",
            class: "danger"
        };

    }

    if (percentage < 80) {

        return {
            text: "NEAR THRESHOLD",
            class: "warning"
        };

    }

    return {
        text: "SAFE",
        class: "safe"
    };
}


