    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #f5f7fb;
    color: #172033;
}

/* ================= GENERAL ================= */

.hidden {
    display: none !important;
}

button,
input,
select {
    font-family: inherit;
}


/* ================= LOGIN ================= */

.login-page {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;

    background:
        linear-gradient(135deg, #4f46e5, #7c3aed);
}

.login-card {
    width: 400px;
    max-width: 90%;

    background: white;
    padding: 40px;

    border-radius: 24px;

    box-shadow: 0 20px 60px rgba(0,0,0,0.2);
}

.logo {
    width: 70px;
    height: 70px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: linear-gradient(135deg,#4f46e5,#7c3aed);

    color: white;

    font-size: 22px;
    font-weight: bold;

    border-radius: 18px;

    margin-bottom: 20px;
}

.login-card h1 {
    font-size: 32px;
}

.subtitle {
    color: #6b7280;
    margin: 8px 0 30px;
}

.login-card label {
    display: block;

    font-size: 14px;
    font-weight: bold;

    margin: 18px 0 7px;
}

.login-card input,
.login-card select,
.planner-grid input,
.planner-grid select {

    width: 100%;

    padding: 13px 14px;

    border: 1px solid #d9deea;

    border-radius: 10px;

    outline: none;

    background: white;
}

.login-card input:focus,
.login-card select:focus,
.planner-grid input:focus,
.planner-grid select:focus {
    border-color: #4f46e5;
}

.login-button {

    width: 100%;

    padding: 14px;

    border: none;
    border-radius: 10px;

    margin-top: 25px;

    color: white;

    font-size: 16px;
    font-weight: bold;

    background: #4f46e5;

    cursor: pointer;
}

.login-button:hover {
    background: #4338ca;
}

.login-info {
    text-align: center;

    margin-top: 20px;

    font-size: 12px;

    color: #8a93a5;
}


/* ================= APP ================= */

.app {
    min-height: 100vh;
}


/* ================= SIDEBAR ================= */

.sidebar {

    position: fixed;

    left: 0;
    top: 0;

    width: 250px;
    height: 100vh;

    background: #111827;

    color: white;

    padding: 25px 15px;

    display: flex;
    flex-direction: column;

    z-index: 10;
}

.brand {

    display: flex;
    align-items: center;

    gap: 12px;

    padding: 10px;

    margin-bottom: 35px;
}

.brand-logo {

    width: 42px;
    height: 42px;

    border-radius: 12px;

    display: flex;
    justify-content: center;
    align-items: center;

    background: #4f46e5;

    font-weight: bold;
}

.brand strong {
    display: block;
}

.brand small {
    color: #9ca3af;
    font-size: 11px;
}

nav {
    display: flex;
    flex-direction: column;

    gap: 7px;
}

.nav-button {

    width: 100%;

    border: none;

    background: transparent;

    color: #b9c0ce;

    text-align: left;

    padding: 13px;

    border-radius: 10px;

    cursor: pointer;

    font-size: 14px;
}

.nav-button:hover {
    background: #1f2937;
    color: white;
}

.nav-button.active {
    background: #4f46e5;
    color: white;
}

.logout-button {

    margin-top: auto;

    padding: 13px;

    border: none;

    border-radius: 10px;

    background: #1f2937;

    color: white;

    cursor: pointer;
}

.logout-button:hover {
    background: #374151;
}


/* ================= MAIN ================= */

.main-content {

    margin-left: 250px;

    padding: 30px;

    min-height: 100vh;
}

.topbar {

    display: flex;

    justify-content: space-between;
    align-items: center;

    margin-bottom: 25px;
}

.topbar h2 {
    font-size: 24px;
}

.topbar p {
    color: #7a8395;

    margin-top: 4px;
}

.profile {

    display: flex;

    align-items: center;

    gap: 10px;
}

.profile-avatar {

    width: 40px;
    height: 40px;

    display: flex;

    justify-content: center;
    align-items: center;

    border-radius: 50%;

    background: #4f46e5;

    color: white;

    font-weight: bold;
}

.profile small {
    display: block;

    color: #7a8395;

    margin-top: 3px;
}


/* ================= HERO ================= */

.hero {

    display: flex;

    justify-content: space-between;
    align-items: center;

    padding: 35px;

    border-radius: 22px;

    background: linear-gradient(
        135deg,
        #4f46e5,
        #7c3aed
    );

    color: white;

    margin-bottom: 25px;
}

.hero-label {

    font-size: 12px;

    letter-spacing: 2px;

    opacity: 0.8;
}

.hero h1 {

    font-size: 32px;

    line-height: 1.2;

    margin: 12px 0;
}

.hero p {

    max-width: 600px;

    opacity: 0.85;

    line-height: 1.6;
}

.hero-icon {

    font-size: 80px;

    opacity: 0.85;
}


/* ================= STATS ================= */

.stats-grid {

    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap: 18px;

    margin-bottom: 25px;
}

.stat-card {

    background: white;

    padding: 22px;

    border-radius: 16px;

    box-shadow: 0 4px 20px rgba(0,0,0,0.04);
}

.stat-card span {

    color: #747e90;

    font-size: 13px;
}

.stat-card strong {

    display: block;

    font-size: 30px;

    margin: 8px 0;
}

.stat-card small {

    color: #9aa2b1;
}


/* ================= PANELS ================= */

.panel {

    background: white;

    padding: 24px;

    border-radius: 18px;

    box-shadow: 0 4px 20px rgba(0,0,0,0.04);

    margin-bottom: 22px;
}

.panel-header {

    display: flex;

    justify-content: space-between;

    margin-bottom: 20px;
}

.panel-header h3 {
    margin-bottom: 5px;
}

.panel-header p {

    color: #858e9f;

    font-size: 13px;
}


/* ================= DASHBOARD GRID ================= */

.dashboard-grid {

    display: grid;

    grid-template-columns:
        1fr 1fr;

    gap: 22px;
}


/* ================= CLASS ITEMS ================= */

.class-item {

    display: flex;

    justify-content: space-between;
    align-items: center;

    padding: 14px;

    border: 1px solid #edf0f5;

    border-radius: 12px;

    margin-bottom: 10px;
}

.class-info strong {
    display: block;
}

.class-info small {
    color: #7e8797;
}

.class-time {

    font-weight: bold;

    color: #4f46e5;

    font-size: 13px;
}


/* ================= SUBJECT CARDS ================= */

.subject-grid {

    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 18px;
}

.subject-card {

    background: white;

    padding: 22px;

    border-radius: 18px;

    box-shadow: 0 4px 20px rgba(0,0,0,0.04);
}

.subject-card h3 {

    margin-bottom: 5px;
}

.subject-card .faculty {

    color: #7d8696;

    font-size: 13px;

    margin-bottom: 18px;
}

.attendance-number {

    font-size: 32px;

    font-weight: bold;

    margin-bottom: 10px;
}

.progress {

    height: 8px;

    background: #edf0f5;

    border-radius: 10px;

    overflow: hidden;
}

.progress-bar {

    height: 100%;

    border-radius: 10px;
}

.subject-details {

    display: flex;

    justify-content: space-between;

    margin-top: 12px;

    font-size: 13px;

    color: #727c8f;
}


/* ================= STATUS ================= */

.status {

    display: inline-block;

    padding: 5px 9px;

    border-radius: 20px;

    font-size: 11px;

    font-weight: bold;
}

.safe {

    color: #047857;

    background: #d1fae5;
}

.warning {

    color: #b45309;

    background: #fef3c7;
}

.danger {

    color: #b91c1c;

    background: #fee2e2;
}


/* ================= SECTION HEADING ================= */

.section-heading {

    margin-bottom: 22px;
}

.section-heading h2 {

    font-size: 26px;

    margin-bottom: 5px;
}

.section-heading p {

    color: #7d8797;
}


/* ================= PLANNER ================= */

.planner-grid {

    display: grid;

    grid-template-columns:
        1fr 1fr;

    gap: 22px;

    margin-bottom: 22px;
}

.planner-grid h3 {

    margin: 15px 0 8px;
}

.planner-grid h3:first-child {
    margin-top: 0;
}

.planner-result {

    background: white;

    padding: 30px;

    border-radius: 18px;

    box-shadow: 0 4px 20px rgba(0,0,0,0.04);
}

.planner-result h2 {
    margin-bottom: 10px;
}

.result-number {

    font-size: 48px;

    font-weight: bold;

    margin: 15px 0;
}

.result-message {

    font-size: 16px;

    line-height: 1.6;
}

.recovery-panel {

    margin-top: 20px;
}

.recovery-box {

    padding: 20px;

    border-radius: 14px;

    background: #f8fafc;

    margin-top: 15px;
}


/* ================= INSIGHTS ================= */

.insight {

    display: flex;

    gap: 12px;

    padding: 14px;

    background: #f8fafc;

    border-radius: 12px;

    margin-bottom: 10px;
}

.insight-icon {

    font-size: 20px;
}


/* ================= TABLE ================= */

.table-container {

    background: white;

    border-radius: 18px;

    overflow-x: auto;

    box-shadow: 0 4px 20px rgba(0,0,0,0.04);
}

table {

    width: 100%;

    border-collapse: collapse;

    min-width: 700px;
}

th {

    background: #f8fafc;

    text-align: left;

    padding: 15px;

    font-size: 13px;

    color: #687386;
}

td {

    padding: 15px;

    border-top: 1px solid #edf0f5;

    font-size: 14px;
}


/* ================= MOBILE ================= */

@media(max-width: 1000px) {

    .stats-grid {

        grid-template-columns:
            repeat(2, 1fr);
    }

    .subject-grid {

        grid-template-columns:
            repeat(2, 1fr);
    }

    .dashboard-grid,
    .planner-grid {

        grid-template-columns: 1fr;
    }

}

@media(max-width: 700px) {

    .sidebar {

        width: 70px;

        padding: 15px 8px;
    }

    .brand div:not(.brand-logo),
    .nav-button {
        font-size: 0;
    }

    .nav-button::first-letter {
        font-size: 20px;
    }

    .logout-button {
        font-size: 0;
    }

    .main-content {

        margin-left: 70px;

        padding: 15px;
    }

    .stats-grid {

        grid-template-columns: 1fr;
    }

    .subject-grid {

        grid-template-columns: 1fr;
    }

    .hero {

        padding: 25px;
    }

    .hero h1 {

        font-size: 24px;
    }

    .hero-icon {
        display: none;
    }

    .profile div:last-child {
        display: none;
    }

