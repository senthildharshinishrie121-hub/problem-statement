<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>AttendWise - Smart Attendance Dashboard</title>

    <link rel="stylesheet" href="style.css">

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body>

<!-- ================= LOGIN ================= -->

<div id="loginPage" class="login-page">

    <div class="login-card">

        <div class="logo">AW</div>

        <h1>AttendWise</h1>

        <p class="subtitle">
            Smart Attendance & Class Planning
        </p>

        <label>Student Name</label>

        <input
            type="text"
            id="studentName"
            placeholder="Enter your name"
            value="Sachit"
        >

        <label>Class Section</label>

        <select id="studentSection">
            <option>EEE-A</option>
            <option>EEE-B</option>
            <option>EEE-C</option>
            <option>ECE-A</option>
            <option>ECE-B</option>
            <option>CSE-A</option>
            <option>CSE-B</option>
            <option>MECH-A</option>
            <option>CIVIL-A</option>
            <option>AIDS-A</option>
        </select>

        <button class="login-button" onclick="login()">
            Enter Dashboard
        </button>

        <p class="login-info">
            Semester: 29 Aug 2026 – 29 Nov 2026
        </p>

    </div>

</div>


<!-- ================= MAIN APPLICATION ================= -->

<div id="app" class="app hidden">

    <!-- SIDEBAR -->

    <aside class="sidebar">

        <div class="brand">
            <div class="brand-logo">AW</div>

            <div>
                <strong>AttendWise</strong>
                <small>Smart Attendance</small>
            </div>
        </div>

        <nav>

            <button class="nav-button active" onclick="showPage('dashboard')">
                🏠 Dashboard
            </button>

            <button class="nav-button" onclick="showPage('attendance')">
                📊 Attendance
            </button>

            <button class="nav-button" onclick="showPage('planner')">
                🧮 Attendance Planner
            </button>

            <button class="nav-button" onclick="showPage('classes')">
                📚 Upcoming Classes
            </button>

            <button class="nav-button" onclick="showPage('timetable')">
                🗓 Timetable
            </button>

            <button class="nav-button" onclick="showPage('history')">
                📋 History
            </button>

        </nav>

        <button class="logout-button" onclick="logout()">
            🚪 Logout
        </button>

    </aside>


    <!-- MAIN CONTENT -->

    <main class="main-content">

        <!-- TOP BAR -->

        <header class="topbar">

            <div>
                <h2 id="pageTitle">Dashboard</h2>
                <p id="welcomeText">Welcome back!</p>
            </div>

            <div class="profile">
                <div class="profile-avatar">S</div>

                <div>
                    <strong id="profileName">Sachit</strong>
                    <small id="profileSection">EEE-A</small>
                </div>
            </div>

        </header>


        <!-- ================= DASHBOARD ================= -->

        <section id="dashboard" class="page">

            <div class="hero">

                <div>
                    <span class="hero-label">
                        SMART ATTENDANCE
                    </span>

                    <h1>
                        Plan your classes.<br>
                        Protect your attendance.
                    </h1>

                    <p>
                        Know exactly how many classes you can miss
                        without falling below the required attendance.
                    </p>
                </div>

                <div class="hero-icon">
                    📊
                </div>

            </div>


            <!-- STATS -->

            <div class="stats-grid">

                <div class="stat-card">
                    <span>Overall Attendance</span>
                    <strong id="overallAttendance">0%</strong>
                    <small>Current semester</small>
                </div>

                <div class="stat-card">
                    <span>Classes Attended</span>
                    <strong id="totalAttended">0</strong>
                    <small>So far</small>
                </div>

                <div class="stat-card">
                    <span>Classes Conducted</span>
                    <strong id="totalConducted">0</strong>
                    <small>So far</small>
                </div>

                <div class="stat-card">
                    <span>Safe Absences</span>
                    <strong id="safeAbsences">0</strong>
                    <small>Before reaching 75%</small>
                </div>

            </div>


            <div class="dashboard-grid">

                <!-- TODAY -->

                <div class="panel">

                    <div class="panel-header">
                        <div>
                            <h3>Today's Classes</h3>
                            <p id="todayDate"></p>
                        </div>
                    </div>

                    <div id="todayClasses"></div>

                </div>


                <!-- CHART -->

                <div class="panel">

                    <div class="panel-header">
                        <div>
                            <h3>Attendance Overview</h3>
                            <p>Subject-wise attendance</p>
                        </div>
                    </div>

                    <canvas id="attendanceChart"></canvas>

                </div>

            </div>


            <!-- INSIGHTS -->

            <div class="panel">

                <div class="panel-header">
                    <div>
                        <h3>Smart Insights</h3>
                        <p>Things you should know</p>
                    </div>
                </div>

                <div id="insights"></div>

            </div>

        </section>


        <!-- ================= ATTENDANCE ================= -->

        <section id="attendance" class="page hidden">

            <div class="section-heading">
                <h2>Subject Attendance</h2>
                <p>Track your attendance subject by subject.</p>
            </div>

            <div id="attendanceCards" class="subject-grid"></div>

        </section>


        <!-- ================= PLANNER ================= -->

        <section id="planner" class="page hidden">

            <div class="section-heading">

                <h2>Attendance Planner</h2>

                <p>
                    Find out whether you can safely miss a class.
                </p>

            </div>


            <div class="planner-grid">

                <div class="panel">

                    <h3>Select Subject</h3>

                    <select id="plannerSubject"
                            onchange="updatePlanner()">
                    </select>


                    <h3>Select Number of Classes</h3>

                    <input
                        type="number"
                        id="plannerClasses"
                        value="1"
                        min="1"
                        max="20"
                        onchange="updatePlanner()"
                    >

                </div>


                <div id="plannerResult" class="planner-result">

                    <h2>Select a subject</h2>

                    <p>
                        Your attendance calculation will appear here.
                    </p>

                </div>

            </div>


            <!-- RECOVERY -->

            <div class="panel recovery-panel">

                <h3>Attendance Recovery Planner</h3>

                <p>
                    If your attendance is below 75%, see how many
                    consecutive classes you need to attend.
                </p>

                <div id="recoveryResult"></div>

            </div>

        </section>


        <!-- ================= UPCOMING CLASSES ================= -->

        <section id="classes" class="page hidden">

            <div class="section-heading">

                <h2>Upcoming Classes</h2>

                <p>
                    Your upcoming timetable.
                </p>

            </div>

            <div id="upcomingClasses"></div>

        </section>


        <!-- ================= TIMETABLE ================= -->

        <section id="timetable" class="page hidden">

            <div class="section-heading">

                <h2>Weekly Timetable</h2>

                <p>
                    Section timetable
                </p>

            </div>

            <div class="table-container">

                <table>

                    <thead>

                        <tr>
                            <th>Day</th>
                            <th>Time</th>
                            <th>Subject</th>
                            <th>Faculty</th>
                            <th>Room</th>
                        </tr>

                    </thead>

                    <tbody id="timetableBody"></tbody>

                </table>

            </div>

        </section>


        <!-- ================= HISTORY ================= -->

        <section id="history" class="page hidden">

            <div class="section-heading">

                <h2>Attendance History</h2>

                <p>
                    Recent attendance records.
                </p>

            </div>

            <div class="table-container">

                <table>

                    <thead>

                        <tr>
                            <th>Date</th>
                            <th>Subject</th>
                            <th>Time</th>
                            <th>Status</th>
                        </tr>

                    </thead>

                    <tbody id="historyBody"></tbody>

                </table>

            </div>

        </section>

    </main>

</div>


<script src="app.js"></script>

</body>
